# Local development: copy to .env, keep ONE cloud section and ONE deploy section uncommented, and replace
# the example values. Runs against your current kube context and cloud credentials. Changes are real.
# deploy/helm/kube-siesta/values.yaml has the same sections for the cluster.

# --- Common -----------------------------------------------------------------------------------------
SIESTA_MANAGED_NAMESPACES=["dev*"]
SIESTA_PROTECTED_NODEPOOLS=[]
SIESTA_DEFAULT_WAKE_NODE_COUNT=1
# Prefix of the labels/annotations the app writes; use a domain you own
SIESTA_LABEL_PREFIX=kube-siesta.example.com
SIESTA_STATE_DB_PATH=./data/kube-siesta.db
SIESTA_SCHEDULE_INTERVAL_SECONDS=300

# --- Schedule ---------------------------------------------------------------------------------------
SIESTA_TIMEZONE=UTC
SIESTA_WEEKEND_START_DAY=fri
SIESTA_WEEKEND_START_TIME=21:00
SIESTA_WEEKEND_END_DAY=mon
SIESTA_WEEKEND_END_TIME=07:00
SIESTA_NIGHTLY_ENABLED=false
SIESTA_NIGHTLY_START_TIME=21:00
SIESTA_NIGHTLY_END_TIME=07:00
SIESTA_LEASE_HOURS=8

# === Cloud: keep ONE =================================================================================

# --- AKS (uses `az login` credentials) --------------------------------------------------------------
SIESTA_PROVIDER=aks
SIESTA_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
SIESTA_AZURE_RESOURCE_GROUP=my-resource-group
SIESTA_AKS_CLUSTER_NAME=my-cluster
SIESTA_PROTECTED_NAMESPACES=["kube-*", "default", "kube-siesta", "cert-manager"]
# System pools must keep at least one node; user pools not listed go to 0
SIESTA_WEEKEND_NODE_COUNTS={"systempool": 1}

# --- EKS (uses AWS credentials: AWS_PROFILE etc.) ---------------------------------------------------
# SIESTA_PROVIDER=eks
# SIESTA_AWS_REGION=us-east-1
# SIESTA_EKS_CLUSTER_NAME=my-cluster
# # EKS has no system/user modes: node groups listed here are kept at >= 1 node
# SIESTA_SYSTEM_NODEPOOLS=["system"]
# # Managed node groups left to the cluster autoscaler (never scaled by hand)
# SIESTA_AUTOSCALED_NODEPOOLS=[]
# SIESTA_PROTECTED_NAMESPACES=["kube-*", "default", "kube-siesta", "ingress-nginx"]
# SIESTA_WEEKEND_NODE_COUNTS={"system": 1}

# === Deployed by: keep ONE ===========================================================================

# --- Plain manifests (kubectl apply, Kustomize, CI), no GitOps --------------------------------------
# Re-applying a namespace's manifests while it sleeps brings its replicas back; wake it first.
SIESTA_FLUX_ENABLED=false
SIESTA_ARGOCD_ENABLED=false

# --- Flux -------------------------------------------------------------------------------------------
# Label each namespace's Flux Kustomization with <SIESTA_LABEL_PREFIX>/namespace=<ns> (see README, "Flux").
# SIESTA_FLUX_ENABLED=true
# SIESTA_FLUX_NAMESPACE=flux-system
# SIESTA_REQUIRE_FLUX_ISOLATION=true
# SIESTA_ARGOCD_ENABLED=false

# --- Argo CD ----------------------------------------------------------------------------------------
# Label each namespace's Application with <SIESTA_LABEL_PREFIX>/namespace=<ns> (see README, "Argo CD").
# SIESTA_FLUX_ENABLED=false
# SIESTA_ARGOCD_ENABLED=true
# SIESTA_ARGOCD_NAMESPACE=argocd
# SIESTA_REQUIRE_ARGOCD_ISOLATION=true

# === Optional ========================================================================================

# --- KEDA -------------------------------------------------------------------------------------------
# Pause ScaledObjects/ScaledJobs while their namespace sleeps. Set to true if the cluster runs KEDA.
SIESTA_KEDA_ENABLED=false
